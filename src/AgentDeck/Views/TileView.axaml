<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgentDeck.ViewModels"
             xmlns:views="using:AgentDeck.Views"
             x:Class="AgentDeck.Views.TileView"
             x:DataType="vm:TileViewModel">

    <UserControl.Styles>

        <!-- ═══ Точка статуса ═══ -->

        <!-- Плейсхолдер: пунктирный контур -->
        <Style Selector="Ellipse.dot">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{StaticResource IndustryIcon}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeDashArray" Value="1.5,1.5" />
        </Style>

        <!-- Жив и ход за пользователем: сплошной акцент без мигания. Так горит и
             обычный терминал — состояний у него не разобрать, и мигать ему
             нечем, — и агент, отработавший запрос. -->
        <Style Selector="Ellipse.dot.running, Ellipse.dot.awaiting-input">
            <Setter Property="Fill" Value="{StaticResource IndustryAccent}" />
            <Setter Property="Stroke" Value="Transparent" />
            <Setter Property="StrokeDashArray" Value="{x:Null}" />
        </Style>

        <!-- Модель работает: сплошной акцент, мигание -->
        <Style Selector="Ellipse.dot.working">
            <Setter Property="Fill" Value="{StaticResource IndustryAccent}" />
            <Setter Property="Stroke" Value="Transparent" />
            <Setter Property="StrokeDashArray" Value="{x:Null}" />
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.25" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Ждёт подтверждения: контур акцентом -->
        <Style Selector="Ellipse.dot.awaiting-permission">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{StaticResource IndustryAccent}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeDashArray" Value="{x:Null}" />
        </Style>

        <!-- Завершён: серая точка -->
        <Style Selector="Ellipse.dot.finished">
            <Setter Property="Fill" Value="{StaticResource IndustryMuted}" />
            <Setter Property="Stroke" Value="Transparent" />
            <Setter Property="StrokeDashArray" Value="{x:Null}" />
        </Style>

        <!-- Упал: серый контур -->
        <Style Selector="Ellipse.dot.crashed">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{StaticResource IndustryIcon}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeDashArray" Value="{x:Null}" />
        </Style>

        <!-- ═══ Рамка тайла, тонированная статусом ═══ -->

        <Style Selector="Border.frame">
            <Setter Property="BorderBrush" Value="{StaticResource IndustryDashedBorder}" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Рамка живого и занятого тайла одна: внимания просит не работа
             модели, а её результат. -->
        <Style Selector="Border.frame.running, Border.frame.working">
            <Setter Property="BorderBrush" Value="{StaticResource IndustryHairline}" />
        </Style>

        <Style Selector="Border.frame.awaiting-input">
            <Setter Property="BorderBrush" Value="{StaticResource IndustryAccent}" />
        </Style>

        <Style Selector="Border.frame.awaiting-permission">
            <Setter Property="BorderBrush" Value="{StaticResource IndustryAccentPressed}" />
        </Style>

        <Style Selector="Border.frame.finished">
            <Setter Property="BorderBrush" Value="{StaticResource IndustryHairline}" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <Style Selector="Border.frame.crashed">
            <Setter Property="BorderBrush" Value="{StaticResource IndustryStrongBorder}" />
        </Style>

    </UserControl.Styles>

    <Border Classes="frame"
            Classes.running="{Binding IsRunning}"
            Classes.working="{Binding IsWorking}"
            Classes.awaiting-input="{Binding IsAwaitingInput}"
            Classes.awaiting-permission="{Binding IsAwaitingPermission}"
            Classes.finished="{Binding IsFinished}"
            Classes.crashed="{Binding IsCrashed}"
            Background="{StaticResource IndustryBackground}"
            BorderThickness="1"
            ClipToBounds="True">

        <DockPanel LastChildFill="True">

            <!-- Заголовок: точка статуса, имя, путь, кнопки -->
            <Border x:Name="Header"
                    DockPanel.Dock="Top"
                    Padding="10,7"
                    Background="Transparent"
                    BorderBrush="{StaticResource IndustryHairline}"
                    BorderThickness="0,0,0,1">

                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">

                    <Ellipse Grid.Column="0"
                             Classes="dot"
                             Classes.running="{Binding IsRunning}"
                             Classes.working="{Binding IsWorking}"
                             Classes.awaiting-input="{Binding IsAwaitingInput}"
                             Classes.awaiting-permission="{Binding IsAwaitingPermission}"
                             Classes.finished="{Binding IsFinished}"
                             Classes.crashed="{Binding IsCrashed}"
                             Width="7" Height="7"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Classes="heading"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Text="{Binding Title, Converter={x:Static views:TextCase.Upper}}" />

                    <!-- Ширину кнопка берёт по тексту, а не по колонке: остаток
                         полосы заголовка должен остаться местом, за которое
                         тайл перетаскивают. -->
                    <Button Grid.Column="2"
                            Classes="link"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{Binding Directory}"
                            Click="OnPathClick">
                        <TextBlock Classes="path"
                                   Text="{Binding Directory}" />
                    </Button>

                    <Button Grid.Column="3"
                            Classes="icon"
                            Content="&#x21BB;"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding CanRestart}"
                            ToolTip.Tip="Restart"
                            Click="OnRestartClick" />

                    <Button Grid.Column="4"
                            Classes="icon"
                            Content="&#x2715;"
                            Margin="2,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Close"
                            Click="OnCloseClick" />

                </Grid>
            </Border>

            <!-- Тело: плейсхолдер до запуска, терминал после -->
            <Panel>
                <views:TilePlaceholderView IsVisible="{Binding IsPlaceholder}" />
                <views:TileTerminalView IsVisible="{Binding !IsPlaceholder}" />
            </Panel>

        </DockPanel>
    </Border>

</UserControl>
