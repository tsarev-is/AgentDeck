<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:AgentDeck.Controls"
        xmlns:vm="using:AgentDeck.ViewModels"
        x:Class="AgentDeck.MainWindow"
        x:DataType="vm:DeckViewModel"
        Title="AgentDeck"
        Width="1280" Height="800"
        MinWidth="640" MinHeight="400"
        Background="{StaticResource IndustryBackground}"
        Foreground="{StaticResource IndustryText}"
        FontFamily="{StaticResource IndustryBodyFont}">

    <DockPanel LastChildFill="True">

        <!-- Titlebar 44 px -->
        <Border DockPanel.Dock="Top"
                Height="44"
                Padding="20,0"
                BorderBrush="{StaticResource IndustryHairline}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <TextBlock Grid.Column="0"
                           Classes="brand"
                           Text="AGENTDECK"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">

                    <Button Classes="primary"
                            Content="+ Agent"
                            IsEnabled="{Binding CanAddTile}"
                            Click="OnAddTileClick" />

                    <Button Content="Settings"
                            ToolTip.Tip="Default directory and CLI utilities"
                            Click="OnSettingsClick" />

                </StackPanel>

            </Grid>
        </Border>

        <!-- Контент-зона дека -->
        <Panel Margin="7">

            <controls:DeckCanvas x:Name="DeckSurface" Deck="{Binding}" />

            <TextBlock Classes="mono muted"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       IsVisible="{Binding IsEmpty}"
                       Text="Click “+ Agent” to start" />

        </Panel>

    </DockPanel>

</Window>
